# Comma-separated hostnames allowed for server-side audits (no protocols).
# Example:
OPEN_GEO_ALLOWED_HOSTS=www.msbproject.my.id,msbproject.my.id

# Required for server-side audits in production. Keep this value private.
# OPEN_GEO_API_KEY=generate-a-long-secret-in-your-deployment-environment

# Without these variables the UI still supports JSON import, export and local history.
